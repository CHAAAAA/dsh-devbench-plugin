{
  "name": "dsh-devbench-plugin",
  "version": "1.0.5",
  "description": "DSH DevBench 插件：按工作区管理 Markdown 需求，AI 提交与代码评审，Git 工作树、后台任务与周报",
  "type": "module",
  "main": "dist/index.js",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "wangyc",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHAAAAA/dsh-devbench-plugin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "devbench",
    "requirements",
    "project-management",
    "markdown",
    "typescript"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/host",
    "dist/shared",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "manifestVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsx scripts/build-host.ts",
    "build:client": "tsx scripts/build-client.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/host/*.test.ts test/client/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "messages:check": "tsx scripts/check-messages.ts",
    "check": "npm run lint && npm run typecheck && npm run messages:check && npm test",
    "verify:publish": "tsx scripts/release/preflight.ts",
    "release:preflight": "tsx scripts/release/preflight.ts",
    "release:pack": "tsx scripts/release/pack.ts",
    "release:publish": "tsx scripts/release/publish.ts",
    "release:catalog": "tsx scripts/release/catalog.ts",
    "release:smoke": "tsx scripts/release/smoke-install.ts",
    "prepack": "npm run build && tsx scripts/release/preflight.ts",
    "prepublishOnly": "tsx scripts/release/preflight.ts --publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
